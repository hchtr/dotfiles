general {
        colors = true
        interval = 5
}

order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "disk /"
order += "memory"
order += "load"
order += "volume master"
order += "tztime local"

wireless _first_ {
        format_up = "W: (%quality at %essid) %ip"
        format_down = "W: down"
}

ethernet _first_ {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}

battery all {
        format = "%status %percentage %remaining"
        status_chr = "CHR"
        status_bat = "BAT"
        status_full = "FULL"
        integer_battery_capacity = true
        low_threshold = 15
}

disk "/" {
        format = "D: %avail"
}

memory {
        format = "M: %used"
        threshold_degraded = "10%"
        format_degraded = "M: LOW %available"
}

load {
        format = "L: %1min"
}

volume master {
        format = "V: %volume"
        format_muted = "V: muted"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}

tztime local {
        format = "%Y-%m-%d %H:%M"
}
